---
import people from "../data/people.json";
const names = [...people].sort((a, b) => a.name.localeCompare(b.name));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>People — Easy Listening</title>
    <style lang="scss">
      @use "../styles/people";
    </style>
  </head>
  <body class="feed">
    <header class="feed__header">
      <a class="feed__logo" href="/" aria-label="Easy Listening">
        <span class="feed__logo-line">easy</span>
        <span class="feed__logo-line">listening.</span>
      </a>
    </header>
    <main class="feed__main">
      <ul class="feed__people">
        {names.map((item) => (
          <li class="feed__person">{item.name}</li>
        ))}
      </ul>
    </main>
  </body>
</html>
