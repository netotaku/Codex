---
// MVP: deliberately unstyled. All playback runs in a single persistent iframe.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Personal Broadcast — Playback Test</title>
<style>
  html { font-family: Arial, Helvetica, sans-serif; font-size: 120%; line-height: 1.4; }
  body { margin: 0; }
  main { max-width: 900px; margin: auto; padding: 0.75rem; }
  #player, #player iframe { width: 100%; max-width: 100%; }
  .controls { display: flex; gap: .5rem; margin: 1rem 0; }
  button { font: inherit; min-height: 44px; }
  .controls button { flex: 1; }
  #queue { list-style: decimal; padding-left: 2rem; }
  #queue li { padding: .2rem; }
  #queue li.selected { background: #dce7f5; }
  #queue li a { display: inline; color: LinkText; text-decoration: underline; text-align: left; font: inherit; padding: .25rem 0; overflow-wrap: anywhere; }
  #queue li .channel { display: inline; font-size: .8em; margin-top: .15rem; }
  #queue li .published { display: inline; font-size: .75em; margin-bottom: .15rem; }
  #queue li.selected a { font-weight: bold; }
  #error { color: #9a1d1d; }
  pre { font-size: .8rem; }
</style>
</head>
<body>
<main>
  <p id="error" role="alert" hidden></p>
  <div id="player" style="width:100%;aspect-ratio:16/9;max-width:900px;background:#ddd"></div>
  <div class="controls">
    <button id="previous">← Prev</button>
    <button id="toggle">Play</button>
    <button id="next">Next →</button>
  </div>
  <h2>Queue</h2>
  <ol id="queue"></ol>
  <h2 id="title" hidden>Waiting for videos</h2>
  <p id="details" hidden></p>
  <label hidden>Position <input id="seek" type="range" min="0" max="1000" value="0" /></label>
  <span id="time" hidden>0:00 / 0:00</span>
  <details><summary>Diagnostics</summary><p id="feed-summary"></p><ul id="source-status"></ul><button id="refresh">Refresh feeds</button> <button id="clear-log">Clear log</button><pre id="log" style="white-space:pre-wrap;max-height:300px;overflow:auto"></pre></details>
</main>
<script>
const $ = (id) => document.getElementById(id);
const STORAGE = 'personal-broadcast-v1';
const QUEUE_STORAGE = 'personal-broadcast-queue-v1';
const readQueue = () => { try { const value = JSON.parse(localStorage.getItem(QUEUE_STORAGE) || '[]'); return Array.isArray(value) ? value : []; } catch { return []; } };
let items = readQueue(), index = 0, player, ready = false, started = false, isSeeking = false;
let lastSavedAt = 0;
const stored = (() => { try { return JSON.parse(localStorage.getItem(STORAGE) || '{}'); } catch { return {}; } })();
const log = (event, detail = '') => {
  const line = new Date().toLocaleTimeString() + ' ' + event + (detail ? ' ' + detail : '');
  $('log').textContent = (line + '\n' + $('log').textContent).slice(0, 12000);
  console.info('[broadcast]', line);
};
const setStatus = (value) => { log(value); };
const showError = (message) => { $('error').hidden = !message; $('error').textContent = message; };
const format = (seconds) => { const s = Math.max(0, Math.floor(Number(seconds) || 0)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };
function save(force = false) {
  if (!force && Date.now() - lastSavedAt < 4000) return;
  lastSavedAt = Date.now();
  try {
    localStorage.setItem(STORAGE, JSON.stringify({
      videoId: items[index]?.videoId, index,
      position: ready && player?.getCurrentTime ? player.getCurrentTime() : 0,
      updated: Date.now()
    }));
  } catch (error) { log('storage error', String(error)); }
}
function render() {
  const current = items[index];

  $('title').textContent = current?.title || 'No videos available';
  $('details').textContent = current ? `${current.source} · ${new Date(current.published).toLocaleString()}` : '';
  $('queue').replaceChildren(...items.map((item, i) => {
    const li = document.createElement('li');
    if (i === index) { li.className = 'selected'; li.setAttribute('aria-current', 'true'); }
    const published = document.createElement('small');
    published.className = 'published';
    const date = new Date(item.published);
    published.textContent = Number.isNaN(date.getTime()) ? '' : date.toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false });
    const link = document.createElement('a');
    link.href = '#player';
    link.textContent = item.title;
    link.addEventListener('click', (event) => { event.preventDefault(); go(i); });
    const channel = document.createElement('span');
    channel.className = 'channel';
    channel.textContent = item.source;
    li.append(published, document.createElement('br'), link, document.createElement('br'), channel);
    return li;
  }));
}
function go(nextIndex) {
  if (!items.length || nextIndex < 0 || nextIndex >= items.length) return;
  index = nextIndex;
  showError('');
  render();
  save(true);
  if (ready) {
    player.loadVideoById(items[index].videoId);
    log('loadVideoById', items[index].videoId);
  }
}
function next() { go(index + 1); }
function previous() { go(index - 1); }
function toggle() {
  if (!ready) return;
  const state = player.getPlayerState();
  if (state === YT.PlayerState.PLAYING) player.pauseVideo();
  else player.playVideo();
}
async function loadFeed() {
  setStatus('Fetching public channel feeds…');
  try {
    const response = await fetch('/.netlify/functions/feed', { cache: 'no-store' });
    if (!response.ok) throw new Error('Feed HTTP ' + response.status);
    const data = await response.json();
    if (!Array.isArray(data.items)) throw new Error('Invalid feed response');
    const previousId = items[index]?.videoId || stored.videoId;
    const failedSources = (data.sources || []).filter(source => source.error);
    // Keep previously loaded items when a public feed fails temporarily.
    // A refresh must never replace a populated queue with a partial result.
    const merged = new Map(items.map(item => [item.videoId, item]));
    for (const item of data.items) merged.set(item.videoId, item);
    items = [...merged.values()].sort((a, b) => new Date(b.published) - new Date(a.published)).slice(0, 300);
    try { localStorage.setItem(QUEUE_STORAGE, JSON.stringify(items)); } catch (error) { log('queue cache error', String(error)); }
    const restoredIndex = items.findIndex(item => item.videoId === previousId);
    index = restoredIndex >= 0 ? restoredIndex : 0;
    render();
    $('feed-summary').textContent = `${items.length} queued · ${data.items.length} fetched · ${failedSources.length} source errors.`;
    $('source-status').replaceChildren(...(data.sources || []).map(source => { const li = document.createElement('li'); li.textContent = `${source.name}: ${source.count} videos${source.error ? ' — ' + source.error : ''}`; return li; }));
    if (items.length) showError('');
    for (const source of data.sources || []) if (source.error) log('source unavailable: ' + source.name, source.error);
    if (!items.length) showError('No videos available. See Diagnostics for feed errors.');
    // Refreshing the feed should not restart a video already playing.
    if (ready && items.length && !player.getVideoData()?.video_id) player.cueVideoById(items[index].videoId);
  } catch (error) {
    showError('Feed unavailable. See Diagnostics.');
    $('feed-summary').textContent = error.message;
  }
}
function initPlayer() {
  player = new YT.Player('player', {
    width: '900', height: '506',
    videoId: items[index]?.videoId || '',
    playerVars: { playsinline: 1, rel: 0, origin: location.origin },
    events: {
      onReady: () => {
        ready = true; log('player ready');
        player.getIframe().setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
        if (items.length && stored.videoId === items[index]?.videoId && stored.position > 0) {
          player.cueVideoById({ videoId: items[index].videoId, startSeconds: stored.position });
          log('restored position', format(stored.position));
        }
      },
      onStateChange: (event) => {
        const states = { '-1':'unstarted', 0:'ended', 1:'playing', 2:'paused', 3:'buffering', 5:'cued' };
        log('player state', states[event.data] || event.data);
        $('toggle').textContent = event.data === YT.PlayerState.PLAYING ? 'Pause' : 'Play';
        if (event.data === YT.PlayerState.PLAYING) showError('');
        if (event.data === YT.PlayerState.ENDED) next();
        if (event.data === YT.PlayerState.PAUSED) save(true);
      },
      onError: (event) => {
        log('player error', String(event.data));
        if (event.data === 153) showError('YouTube playback error 153. Tap Play to retry.');
        else if (event.data === 101 || event.data === 150) showError('Video cannot be embedded. Try Next.');
        else showError('Playback error ' + event.data + '. Tap Play to retry.');
      },
      onAutoplayBlocked: () => log('AUTOPLAY BLOCKED')
    }
  });
}
window.onYouTubeIframeAPIReady = initPlayer;
const script = document.createElement('script');
script.src = 'https://www.youtube.com/iframe_api';
document.head.append(script);
$('toggle').addEventListener('click', () => {
  if (!items.length) { showError('No videos available. See Diagnostics.'); return; }
  if (!ready) { showError('Player is loading. Try again shortly.'); return; }
  const state = player.getPlayerState();
  if (state === YT.PlayerState.PLAYING) player.pauseVideo();
  else if (!started || state === YT.PlayerState.UNSTARTED || state === YT.PlayerState.CUED) {
    started = true; player.loadVideoById(items[index].videoId);
  } else { started = true; player.playVideo(); }
});
$('refresh').addEventListener('click', loadFeed);
$('next').addEventListener('click', next);
$('previous').addEventListener('click', previous);

$('clear-log').addEventListener('click', () => { $('log').textContent = ''; });
$('seek').addEventListener('pointerdown', () => { isSeeking = true; });
$('seek').addEventListener('input', () => { isSeeking = true; });
$('seek').addEventListener('change', () => {
  if (ready) player.seekTo(Number($('seek').value) / 1000 * (player.getDuration() || 0), true);
  isSeeking = false;
});
setInterval(() => {
  if (!ready) return;
  const duration = player.getDuration() || 0;
  const current = player.getCurrentTime() || 0;
  $('time').textContent = format(current) + ' / ' + format(duration);
  if (!isSeeking && duration) $('seek').value = String(Math.round(current / duration * 1000));
  if (player.getPlayerState() === YT.PlayerState.PLAYING) save();
}, 1000);
document.addEventListener('visibilitychange', () => { log('visibility', document.visibilityState); save(true); });
window.addEventListener('pagehide', () => { log('pagehide'); save(true); });
window.addEventListener('pageshow', (e) => log('pageshow', e.persisted ? 'bfcache' : 'normal'));
let touchStart = null;
document.addEventListener('touchstart', (e) => {
  if (e.target.closest('button, input, details, #player')) return;
  const t = e.changedTouches[0];
  touchStart = { x:t.clientX, y:t.clientY };
}, { passive:true });
document.addEventListener('touchend', (e) => {
  if (!touchStart) return;
  const t = e.changedTouches[0];
  const dx = t.clientX - touchStart.x, dy = t.clientY - touchStart.y;
  touchStart = null;
  if (Math.abs(dx) > 65 && Math.abs(dx) > Math.abs(dy) * 1.5) dx > 0 ? next() : previous();
}, { passive:true });
document.addEventListener('keydown', (e) => {
  if (e.target instanceof HTMLInputElement) return;
  if (e.key === 'ArrowRight') next();
  if (e.key === 'ArrowLeft') previous();
});
if (items.length) { index = Math.max(0, items.findIndex(item => item.videoId === stored.videoId)); render(); setStatus(`${items.length} cached videos; refreshing sources…`); }
loadFeed();
</script>
</body>
</html>
