<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#f4eee0"/><title>Easy Listening</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root{font-family:'Space Grotesk',sans-serif;background:#f4eee0;color:#27271f;font-synthesis:none}*{box-sizing:border-box}body{margin:0}
header{padding:clamp(26px,5vw,70px) clamp(22px,6vw,90px) clamp(32px,5vw,75px);border-bottom:2px solid currentColor}
.logo{font-size:clamp(76px,14vw,230px);font-weight:700;line-height:.76;letter-spacing:-.105em;display:inline-block;text-decoration:none;color:inherit}.logo span{display:block}
main{padding:0 clamp(22px,6vw,90px) 100px;max-width:1700px;margin:auto}
.tabs-wrap{position:relative}.tabs{display:flex;gap:35px;align-items:end;border-bottom:1px solid #777769;padding-top:28px;margin-bottom:35px;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none;-webkit-overflow-scrolling:touch;white-space:nowrap}.tabs::-webkit-scrollbar{display:none}.tabs-wrap:after{content:"";position:absolute;right:0;top:0;bottom:35px;width:70px;pointer-events:none;background:linear-gradient(to right,transparent,#f4eee0);opacity:0;transition:opacity .2s}.tabs-wrap.has-overflow:not(.at-end):after{opacity:1}
.tab{flex:0 0 auto;cursor:pointer;font:600 clamp(18px,2vw,27px)/1 'Space Grotesk',sans-serif;letter-spacing:-.045em;padding:0 0 18px;border:0;border-bottom:4px solid #e65d25;margin-bottom:-2px;background:none;color:inherit}.tab:not(.active){border-bottom-color:transparent;color:#777769}.tab:focus-visible{outline:2px solid #e65d25}.tab span{font-size:13px;vertical-align:top;margin-left:7px;letter-spacing:0}
.feed-list{list-style:none;margin:0;padding:0}.feed-list li{border-bottom:1px solid #b7b2a5}.feed-list a{display:block;padding:17px 0;color:inherit;text-decoration:none}.feed-list a:hover .episode-title{color:#e65d25}.episode-title{font-size:clamp(19px,2vw,28px);font-weight:600;letter-spacing:-.045em;line-height:1.18}.episode-meta{display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:8px;font-size:13px;font-weight:600;color:#777769}.episode-description{font-size:15px;line-height:1.5;max-width:850px;margin:9px 0 0;color:#55554b}.feed-status{padding:16px 0;color:#777769}.load-more{margin-top:25px;background:none;border:1px solid #27271f;padding:12px 22px;font:600 16px 'Space Grotesk',sans-serif;cursor:pointer}[hidden]{display:none!important}
@media(max-width:700px){.feed-list{grid-template-columns:1fr}.thumb{width:66px;height:66px;flex-basis:66px}.feed-list a{min-height:84px}.logo{font-size:clamp(68px,16vw,110px)}.tabs{gap:27px;margin-bottom:22px}.tabs-wrap:after{bottom:22px}}
</style></head><body><header><a class="logo" href="/" aria-label="Easy Listening"><span>easy</span><span>listening.</span></a></header><main>
<div class="tabs-wrap"><nav class="tabs" aria-label="Feed categories">{categories.map((category,i)=><button class:list={['tab',{'active':i===0}]} type="button" data-tab={category} aria-selected={i===0?'true':'false'}>{category} <span>{feeds.filter(feed=>feed.category===category).length}</span></button>)}</nav></div>
{categories.map((category,i)=><section data-panel={category} hidden={i!==0}><p class="feed-status" role="status">Loading latest episodes…</p><ul class="feed-list"></ul><button class="load-more" type="button" hidden>Load more episodes</button></section>)}
<script>
