---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#f4eee0" />
<title>Easy Listening</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root{font-family:'Space Grotesk',sans-serif;background:#f4eee0;color:#27271f;font-synthesis:none}
*{box-sizing:border-box}
body{margin:0}
header{padding:clamp(26px,5vw,70px) clamp(22px,6vw,90px) clamp(32px,5vw,75px);border-bottom:2px solid currentColor}
.logo{font-size:clamp(76px,14vw,230px);font-weight:700;line-height:.76;letter-spacing:-.105em;display:inline-block;text-decoration:none;color:inherit}
.logo span{display:block}
main{padding:0 clamp(22px,6vw,90px) 100px;max-width:1700px;margin:auto}
.tabs{display:flex;align-items:end;gap:35px;border-bottom:1px solid #777769;padding-top:28px;margin-bottom:40px;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none;-webkit-overflow-scrolling:touch;white-space:nowrap}.tabs::-webkit-scrollbar{display:none}.tabs-wrap{position:relative}.tabs-wrap:after{content:"";position:absolute;right:0;top:0;bottom:40px;width:65px;pointer-events:none;background:linear-gradient(to right,transparent,#f4eee0);opacity:0;transition:opacity .2s}.tabs-wrap.has-overflow:not(.at-end):after{opacity:1}.tab{flex:0 0 auto}
.tab{font:600 clamp(18px,2vw,27px)/1 'Space Grotesk',sans-serif;letter-spacing:-.045em;padding:0 0 18px;border:0;border-bottom:4px solid #e65d25;margin-bottom:-2px;background:none;color:inherit}
.tab{cursor:pointer}.tab:not(.active){border-bottom-color:transparent;color:#777769}.tab:focus-visible{outline:2px solid #e65d25}.tab span{font-size:13px;vertical-align:top;margin-left:7px;letter-spacing:0}
.list{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:40px}
.list li{font-size:clamp(18px,2vw,27px);font-weight:500;letter-spacing:-.04em;padding:15px 0;border-bottom:1px solid #b7b2a5;line-height:1.15}
.feed-list{list-style:none;margin:0;padding:0}.feed-list li{border-bottom:1px solid #b7b2a5}.feed-list a{display:block;padding:15px 0;color:inherit;text-decoration:none;font-size:clamp(18px,2vw,27px);font-weight:500;letter-spacing:-.04em;line-height:1.15}.feed-list a:hover{color:#e65d25}.feed-list a:focus-visible{outline:2px solid #e65d25}[hidden]{display:none!important}
@media(max-width:800px){.list{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 25px}}
@media(max-width:520px){.logo{font-size:clamp(68px,16vw,110px)}.list{grid-template-columns:1fr}.tabs{margin-bottom:20px}}
</style>
</head>
<body>
<header><a class="logo" href="/" aria-label="Easy Listening"><span>easy</span><span>listening.</span></a></header>
<main>
<div class="tabs-wrap"><nav class="tabs" aria-label="Feed categories">{categories.map((category,i)=><button class:list={['tab',{'active':i===0}]} type="button" data-tab={category} aria-selected={i===0?'true':'false'}>{category} <span>{feeds.filter(feed=>feed.category===category).length}</span></button>)}</nav></div>
{categories.map((category,i)=><section class="feed-panel" data-panel={category} hidden={i!==0}><ul class="feed-list">{feeds.filter(feed=>feed.category===category).map(item=><li><a href={item.url} target="_blank" rel="noopener noreferrer">{item.name}</a></li>)}</ul></section>)}
<script>
const buttons = document.querySelectorAll('[data-tab]');
buttons.forEach(button=>button.addEventListener('click',()=>{
 const selected=button.dataset.tab;
 buttons.forEach(b=>{const active=b.dataset.tab===selected;b.classList.toggle('active',active);b.setAttribute('aria-selected',String(active));});
 document.querySelectorAll('[data-panel]').forEach(panel=>{panel.hidden=panel.dataset.panel!==selected;});
}));
const tabs=document.querySelector('.tabs');const wrap=document.querySelector('.tabs-wrap');
function updateTabFade(){wrap.classList.toggle('has-overflow',tabs.scrollWidth>tabs.clientWidth+2);wrap.classList.toggle('at-end',tabs.scrollLeft+tabs.clientWidth>=tabs.scrollWidth-2)}
tabs.addEventListener('scroll',updateTabFade,{passive:true});window.addEventListener('resize',updateTabFade);updateTabFade();
</script>
</main>
</body>
</html>
