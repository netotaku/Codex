const categories=["Music","News","Technology","Culture","Science","Entertainment"];
const cache=new Map(),inflight=new Map();const normalise=s=>s.toLowerCase().replace(/[^a-z0-9]/g,'');
const textOf=(node,tag)=>node.getElementsByTagName(tag)[0]?.textContent?.trim()||'';
function plain(value){const doc=new DOMParser().parseFromString(value||'','text/html');return (doc.body.textContent||'').replace(/\s+/g,' ').trim().slice(0,280)}
async function resolveFeed(show){
 if(show.url&&(/\.rss($|\?)|\.xml($|\?)|feeds\.|feed\.|rss\.|\/feed\//i.test(show.url)))return show.url;
 const res=await fetch('https://itunes.apple.com/search?'+new URLSearchParams({term:show.name,media:'podcast',entity:'podcast',limit:'8',country:'gb'}));
 if(!res.ok)return null;
 const json=await res.json();
 return json.results?.find(item=>normalise(item.collectionName||'')===normalise(show.name))?.feedUrl||null;
}
async function readFeed(url,show){
 let response=await fetch(url,{signal:AbortSignal.timeout(11000)}).catch(()=>null);
 if(!response?.ok)response=await fetch('https://proxy.cors.dev/'+url,{signal:AbortSignal.timeout(12000)}).catch(()=>null);
 if(!response?.ok)return [];
 const xml=new DOMParser().parseFromString(await response.text(),'application/xml');
 if(xml.querySelector('parsererror'))return [];
 return [...xml.getElementsByTagName('item')].slice(0,8).map(item=>{
 const title=textOf(item,'title'),date=textOf(item,'pubDate');
 const enclosure=item.getElementsByTagName('enclosure')[0]?.getAttribute('url');
 const link=textOf(item,'link')||enclosure||url;
 return {title,source:show.name,date,description:plain(textOf(item,'description')||textOf(item,'content:encoded')||textOf(item,'itunes:summary')),url:link,stamp:Date.parse(date)||0};
 }).filter(e=>e.title&&e.stamp);
}
async function getEpisodes(category){
 if(cache.has(category))return cache.get(category);
 if(inflight.has(category))return inflight.get(category);
 const promise=(async()=>{
 const shows=feedData.filter(f=>f.category===category);
 let next=0;const results=[];
 await Promise.all(Array.from({length:6},async()=>{while(next<shows.length){const show=shows[next++];try{const url=await resolveFeed(show);if(url)results.push(...await readFeed(url,show))}catch{}}}));
 const unique=new Map();for(const e of results){const key=e.source+'|'+e.title;if(!unique.has(key))unique.set(key,e)}
 const episodes=[...unique.values()].sort((a,b)=>b.stamp-a.stamp);
 cache.set(category,episodes);return episodes;
 })();
 inflight.set(category,promise);try{return await promise}finally{inflight.delete(category)}
}
function render(category,items){
 const panel=[...document.querySelectorAll('[data-panel]')].find(p=>p.dataset.panel===category);
 const list=panel.querySelector('.feed-list');const status=panel.querySelector('.feed-status');const more=panel.querySelector('.load-more');
 let shown=0;list.replaceChildren();
 function append(){const fragment=document.createDocumentFragment();for(const e of items.slice(shown,shown+30)){
 const li=document.createElement('li'),a=document.createElement('a');a.href=e.url;a.target='_blank';a.rel='noopener noreferrer';
 const title=document.createElement('div');title.className='episode-title';title.textContent=e.title;
 const meta=document.createElement('div');meta.className='episode-meta';
 const source=document.createElement('span');source.textContent=e.source;
 const date=document.createElement('time');date.dateTime=new Date(e.stamp).toISOString();date.textContent=new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'short',year:'numeric'}).format(e.stamp);
 meta.append(source,date);a.append(title,meta);
 if(e.description){const desc=document.createElement('p');desc.className='episode-description';desc.textContent=e.description;a.append(desc)}
 li.append(a);fragment.append(li)
 }list.append(fragment);shown=Math.min(shown+30,items.length);more.hidden=shown>=items.length}
 more.onclick=append;append();status.hidden=items.length>0;
 if(!items.length)status.textContent='No recent episodes available from the sources that could be reached.';
}
async function loadPanel(category){
 const panel=[...document.querySelectorAll('[data-panel]')].find(p=>p.dataset.panel===category);
 if(cache.has(category)){render(category,cache.get(category));return}
 panel.querySelector('.feed-status').textContent='Loading latest episodes…';
 const episodes=await getEpisodes(category);render(category,episodes)
}
buttons.forEach(button=>button.addEventListener('click',()=>{const selected=button.dataset.tab;buttons.forEach(b=>{const active=b.dataset.tab===selected;b.classList.toggle('active',active);b.setAttribute('aria-selected',String(active))});document.querySelectorAll('[data-panel]').forEach(panel=>panel.hidden=panel.dataset.panel!==selected);button.scrollIntoView({behavior:'smooth',inline:'nearest',block:'nearest'});loadPanel(selected)}));
loadPanel('Music');
