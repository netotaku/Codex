---
import PodcastFeed from "../components/PodcastFeed.vue";
import "../styles/index.scss";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#f4eee0" />
    <title>Easy Listening</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="feed">
    <div class="feed__hero">
      <img
        class="feed__hero-image"
        src="/images/cat-hero.png"
        alt="A smiling white lucky cat with a raised paw"
        width="1680"
        height="896"
        onerror="this.parentElement.hidden=true"
      />
    </div>
    <header class="feed__header">
      <a class="feed__logo" href="/" aria-label="Easy Listening">
        <span class="feed__logo-line">easy</span>
        <span class="feed__logo-line">listening.</span>
      </a>
    </header>
    <main class="feed__main">
      <PodcastFeed client:load />
    </main>
  </body>
</html>
