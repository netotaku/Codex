<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#f4eee0"/><title>Easy Listening</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root{font-family:'Space Grotesk',sans-serif;background:#f4eee0;color:#27271f;font-synthesis:none}*{box-sizing:border-box}body{margin:0}
header{padding:clamp(26px,5vw,70px) clamp(22px,6vw,90px) clamp(32px,5vw,75px);border-bottom:2px solid currentColor}
.logo{font-size:clamp(76px,14vw,230px);font-weight:700;line-height:.76;letter-spacing:-.105em;display:inline-block;text-decoration:none;color:inherit}.logo span{display:block}
main{padding:0 clamp(22px,6vw,90px) 100px;max-width:1700px;margin:auto}
.tabs-wrap{position:relative}.tabs{display:flex;gap:35px;align-items:end;border-bottom:1px solid #777769;padding-top:28px;margin-bottom:35px;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none;-webkit-overflow-scrolling:touch;white-space:nowrap}.tabs::-webkit-scrollbar{display:none}.tabs-wrap:after{content:"";position:absolute;right:0;top:0;bottom:35px;width:70px;pointer-events:none;background:linear-gradient(to right,transparent,#f4eee0);opacity:0;transition:opacity .2s}.tabs-wrap.has-overflow:not(.at-end):after{opacity:1}
.tab{flex:0 0 auto;cursor:pointer;font:600 clamp(18px,2vw,27px)/1 'Space Grotesk',sans-serif;letter-spacing:-.045em;padding:0 0 18px;border:0;border-bottom:4px solid #e65d25;margin-bottom:-2px;background:none;color:inherit}.tab:not(.active){border-bottom-color:transparent;color:#777769}.tab:focus-visible{outline:2px solid #e65d25}.tab span{font-size:13px;vertical-align:top;margin-left:7px;letter-spacing:0}
.feed-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:30px}.feed-list li{border-bottom:1px solid #b7b2a5;min-width:0}.feed-list a{display:flex;align-items:center;gap:16px;min-height:104px;padding:12px 0;color:inherit;text-decoration:none;font-size:clamp(17px,1.8vw,24px);font-weight:500;letter-spacing:-.04em;line-height:1.16}.feed-list a:hover{color:#e65d25}.feed-list a:focus-visible{outline:2px solid #e65d25}
.thumb{flex:0 0 78px;width:78px;height:78px;position:relative;overflow:hidden;background:#e65d25;isolation:isolate}.thumb img{display:block;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(2.1) brightness(1.1);mix-blend-mode:multiply;mask-image:radial-gradient(circle at center,#000 43%,transparent 49%);mask-size:5px 5px;-webkit-mask-image:radial-gradient(circle at center,#000 43%,transparent 49%);-webkit-mask-size:5px 5px}.thumb:after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle,#27271f 36%,transparent 42%) 0 0/5px 5px;opacity:.18}.thumb .fallback{position:absolute;inset:0;display:grid;place-items:center;color:#27271f;font-weight:700;font-size:30px;letter-spacing:-.09em}.thumb:has(img) .fallback{display:none}
.feed-name{min-width:0}[hidden]{display:none!important}
@media(max-width:700px){.feed-list{grid-template-columns:1fr}.thumb{width:66px;height:66px;flex-basis:66px}.feed-list a{min-height:84px}.logo{font-size:clamp(68px,16vw,110px)}.tabs{gap:27px;margin-bottom:22px}.tabs-wrap:after{bottom:22px}}
</style></head><body><header><a class="logo" href="/" aria-label="Easy Listening"><span>easy</span><span>listening.</span></a></header><main>
<div class="tabs-wrap"><nav class="tabs" aria-label="Feed categories">{categories.map((category,i)=><button class:list={['tab',{'active':i===0}]} type="button" data-tab={category} aria-selected={i===0?'true':'false'}>{category} <span>{feeds.filter(feed=>feed.category===category).length}</span></button>)}</nav></div>
{categories.map((category,i)=><section data-panel={category} hidden={i!==0}><ul class="feed-list">{feeds.filter(feed=>feed.category===category).map(item=><li><a href={item.url||'https://podcasts.apple.com/gb/search?term='+encodeURIComponent(item.name)} data-feed-name={item.name} data-has-url={item.url?'yes':'no'} target="_blank" rel="noopener noreferrer"><span class="thumb"><span class="fallback" aria-hidden="true">{item.name.slice(0,1)}</span></span><span class="feed-name">{item.name}</span></a></li>)}</ul></section>)}
<script>
const buttons=document.querySelectorAll('[data-tab]');buttons.forEach(button=>button.addEventListener('click',()=>{const selected=button.dataset.tab;buttons.forEach(b=>{const active=b.dataset.tab===selected;b.classList.toggle('active',active);b.setAttribute('aria-selected',String(active))});document.querySelectorAll('[data-panel]').forEach(panel=>panel.hidden=panel.dataset.panel!==selected);button.scrollIntoView({behavior:'smooth',inline:'nearest',block:'nearest'});loadPanel(selected)}));
const tabs=document.querySelector('.tabs'),wrap=document.querySelector('.tabs-wrap');function updateTabFade(){wrap.classList.toggle('has-overflow',tabs.scrollWidth>tabs.clientWidth+2);wrap.classList.toggle('at-end',tabs.scrollLeft+tabs.clientWidth>=tabs.scrollWidth-2)}tabs.addEventListener('scroll',updateTabFade,{passive:true});window.addEventListener('resize',updateTabFade);updateTabFade();
const loaded=new Set();const normalise=s=>s.toLowerCase().replace(/[^a-z0-9]/g,'');async function resolve(a){const name=a.dataset.feedName;try{const response=await fetch('https://itunes.apple.com/search?'+new URLSearchParams({term:name,media:'podcast',entity:'podcast',limit:'10',country:'gb'}));if(!response.ok)return;const result=await response.json();const match=(result.results||[]).find(x=>normalise(x.collectionName||'')===normalise(name));if(!match)return;const artwork=match.artworkUrl600||match.artworkUrl100;if(artwork){const img=document.createElement('img');img.src=artwork;img.alt='';img.loading='lazy';a.querySelector('.thumb').prepend(img)}if(match.feedUrl){a.href=match.feedUrl;a.dataset.resolved='true'}}catch{}}async function loadPanel(category){if(loaded.has(category))return;loaded.add(category);const q=[...document.querySelectorAll('[data-panel]')].find(p=>p.dataset.panel===category)?.querySelectorAll('[data-feed-name]');if(!q)return;const queue=[...q];await Promise.all(Array.from({length:5},async()=>{while(queue.length)await resolve(queue.shift())}))}loadPanel('Music');
</script></main></body></html>